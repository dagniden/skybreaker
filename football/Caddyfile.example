# Replace the existing football.sky-breaker.ru block; do NOT add a duplicate.
# The original sky-breaker.ru block is unchanged.
football.sky-breaker.ru {
    encode zstd gzip

    @websocket header Upgrade websocket
    handle @websocket {
        reverse_proxy 127.0.0.1:8765
    }

    handle_path /static/* {
        root * /opt/skybreaker/staticfiles
        file_server
    }

    handle_path /downloads/* {
        root * /opt/skybreaker/var/football-downloads
        @release_file path *.zip *.zip.sha256
        handle @release_file {
            header Content-Disposition "attachment"
            header X-Content-Type-Options "nosniff"
            header Cache-Control "public, max-age=3600"
            file_server
        }
        respond 404
    }

    handle {
        request_body {
            max_size 12582912
        }
        reverse_proxy 127.0.0.1:8001
    }
}
